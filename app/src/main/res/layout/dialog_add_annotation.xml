<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Annotation"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#111827" />

    <TextView
        android:id="@+id/tvSelectedTerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:padding="12dp"
        android:background="#F3F4F6"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#0F766E" />

    <EditText
        android:id="@+id/etDefinition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#F9FAFB"
        android:padding="12dp"
        android:hint="Definition or Persian equivalent"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:background="#F9FAFB"
        android:padding="12dp"
        android:hint="Usage note or nuance (optional)"
        android:textColor="#111827"
        android:textColorHint="#9CA3AF"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAnnotation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#0F766E"
        android:text="Save Annotation"
        android:textColor="#FFFFFF" />
</LinearLayout>
