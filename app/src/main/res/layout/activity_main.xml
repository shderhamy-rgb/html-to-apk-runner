<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F0">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAF7F0"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Margin"
                android:textColor="#14120E"
                android:textSize="22sp"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <!-- Clean Icon Actions -->
            <ImageButton
                android:id="@+id/btnOpenFile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open .margin file"
                android:src="@android:drawable/ic_menu_upload"
                app:tint="#655E52" />

            <ImageButton
                android:id="@+id/btnSaveMargin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Save .margin file"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#655E52" />

            <ImageButton
                android:id="@+id/btnEditPassage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Passage"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#655E52" />

            <ImageButton
                android:id="@+id/btnExportHtml"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Export HTML"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#B8860B" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5DEC9" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Reading Canvas -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvDisplayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="#14120E"
                android:textSize="26sp"
                android:textStyle="bold"
                android:text="Weekly Reading" />

            <TextView
                android:id="@+id/tvDisplaySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="#655E52"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="SESSION NOTES" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5DEC9"
                android:layout_marginBottom="20dp" />

            <!-- The Main Editorial Text -->
            <TextView
                android:id="@+id/tvPassage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.6"
                android:textColor="#14120E"
                android:textSize="18sp"
                android:textIsSelectable="true"
                android:text="Tap the edit button above to paste your reading passage, or tap Open to import a .margin file from your laptop." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Selection Pill (Classy & Discreet) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFloatingAnnotate"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#14120E"
        android:elevation="6dp"
        android:text="+ Annotate Word"
        android:textColor="#FAF7F0"
        android:textSize="13sp"
        app:cornerRadius="22dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="#FFE9A8" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
